# LLM gateway (all model calls go through these)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_api_key_here

# Service
PORT=8080
WORKERS=10

# Optional model routing overrides (must be on the allowed list)
# TABLE_MODEL=anthropic/claude-haiku-5.5
# DOCUMENT_MODEL=anthropic/claude-sonnet-5.5
# OCR_MODEL=z-ai/glm-5.3-flash
# TABLE_REASONING=low
# OCR_REASONING=low
